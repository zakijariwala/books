gantt
    title Migration Waves Against Lease Expiry
    dateFormat YYYY-MM-DD
    axisFormat %b
    todayMarker off

    section Foundation
    Landing zone      :a1, 2026-04-01, 60d
    Link and identity :a2, after a1, 45d
    Training          :a3, 2026-05-01, 90d

    section Wave 1
    Internal tools    :b1, after a2, 45d
    Rehearsal         :milestone, b2, after b1, 0d

    section Wave 2
    File share        :c1, after b1, 60d

    section Wave 3
    DB replication    :d1, after c1, 45d
    Batch rehearsal   :d2, after d1, 30d
    App cutover       :d3, after d2, 14d

    section Deadline
    Rollback point    :milestone, e1, 2027-03-24, 0d
    Lease ends        :milestone, e2, 2027-03-31, 0d
