# Build products and rendered assets. Regenerate with `make`; never commit.
assets/
build/

# Python
__pycache__/
*.pyc
venv/
.venv/
.pytest_cache/

# Node (mermaid-cli, if installed locally rather than globally)
node_modules/

# Vale style packages (Google, write-good, proselint) ARE committed here for
# offline, reproducible builds — see styles/README.md. Only Vale's transient
# cache is ignored. To go back to fetch-on-demand, re-add `styles/*/` below and
# keep `!styles/config/`, then `git rm -r --cached` the package dirs.
.vale-styles-cache/

# Editors / OS
.DS_Store
*.swp

# Third-party reference material cloned for research. Keep it out of the repo;
# log what you consulted in sources/research/ instead. See GOVERNANCE.md.
reference-clones/
